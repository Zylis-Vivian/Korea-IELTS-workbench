{
  "name": "lavender-study",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "韩语 + 雅思双轨学习工作台（含多方案 TTS 发音引擎）",
  "scripts": {
    "dev": "concurrently -k -n VITE,API -c magenta,cyan \"vite\" \"node server/index.js\"",
    "server": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "test:data": "node scripts/selftest-v4.mjs",
    "test:ui": "node scripts/selftest-ui.mjs",
    "test:server": "node scripts/selftest-server.mjs",
    "test": "npm run test:data && npm run test:ui && npm run test:server",
    "build": "npm run typecheck && vite build",
    "check": "npm test && npm run build",
    "start": "node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "edge-tts-universal": "^1.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "8.6.2",
    "framer-motion": "^11.3.19",
    "helmet": "8.3.0",
    "lucide-react": "^0.417.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.2",
    "recharts": "^2.12.7",
    "ts-fsrs": "^5.4.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.0.5",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "esbuild": "0.28.2",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "8.2.1"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
