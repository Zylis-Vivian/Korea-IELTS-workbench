# Server
PORT=8787
NODE_ENV=development

# Comma-separated browser origins allowed to call the TTS API.
# Production example: https://study.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TTS_RATE_LIMIT=30
TTS_TIMEOUT_MS=10000

# Set to 1 only when running behind exactly one trusted reverse proxy.
TRUST_PROXY=0

# Optional paid TTS providers. Never expose these values through VITE_* variables.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_TTS_API_KEY=

# Vite: set to 1 only while testing from a trusted LAN/mobile device.
LAN_DEV=0
